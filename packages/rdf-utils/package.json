{
  "name": "@ldo/rdf-utils",
  "version": "1.0.0-alpha.50",
  "description": "Some RDF Utilities to support LDO librariers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && NODE_OPTIONS=--max-old-space-size=8192 tsdown",
    "watch": "tsc --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "prepublishOnly": "npm run build",
    "lint:check": "eslint src/** --no-error-on-unmatched-pattern",
    "lint": "npm run lint:check -- --fix",
    "remove-dist": "rimraf dist/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/o-development/ldo.git"
  },
  "author": "Jackson Morgan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/o-development/ldo/issues"
  },
  "homepage": "https://github.com/o-development/ldo/tree/main/packages/rdf-utils#readme",
  "devDependencies": {
    "@types/jsonld": "^1.5.9"
  },
  "dependencies": {
    "@rdfjs/data-model": "^1.2.0",
    "@rdfjs/types": "^1.0.1",
    "n3": "^1.17.1",
    "rdf-string": "^1.6.3"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "7277a6694f01cdb776495a3028a625d8386c4887"
}
