{
  "name": "@ldo/vue",
  "version": "1.0.0-alpha.53",
  "description": "A Vue library for LDO",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && NODE_OPTIONS=--max-old-space-size=8192 tsdown",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "ldo",
    "linked-data-objects",
    "rdf",
    "solid-project",
    "vuejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/o-development/ldo.git"
  },
  "author": "Jackson Morgan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/o-development/ldo/issues"
  },
  "homepage": "https://github.com/o-development/ldo/tree/main/packages/vue#readme",
  "dependencies": {
    "@ldo/connected": "^1.0.0-alpha.53",
    "@ldo/jsonld-dataset-proxy": "^1.0.0-alpha.53",
    "@ldo/ldo": "^1.0.0-alpha.53",
    "@ldo/rdf-utils": "^1.0.0-alpha.53"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@ldo/connected-solid": "^1.0.0-alpha.53",
    "@ldo/test-solid-server": "^1.0.0-alpha.53",
    "@types/shexj": "^2.1.7",
    "vue": "^3.5.43"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
