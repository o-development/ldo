{
  "name": "@ldo/solid-vue",
  "version": "1.0.0-alpha.50",
  "description": "A Vue library for LDO and Solid",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && NODE_OPTIONS=--max-old-space-size=8192 tsdown",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "ldo",
    "linked-data-objects",
    "rdf",
    "solid-project",
    "vuejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/o-development/ldo.git"
  },
  "author": "Jackson Morgan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/o-development/ldo/issues"
  },
  "homepage": "https://github.com/o-development/ldo/tree/main/packages/solid-vue#readme",
  "dependencies": {
    "@ldo/connected-solid": "^1.0.0-alpha.50",
    "@ldo/vue": "^1.0.0-alpha.50"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "vue": "^3.5.43"
  }
}
