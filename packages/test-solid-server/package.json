{
  "name": "@ldo/test-solid-server",
  "version": "1.0.0-alpha.53",
  "description": "A solid server to be used in jest tests",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
