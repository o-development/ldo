{
  "name": "@ldo/solid-react",
  "version": "1.0.0-alpha.53",
  "description": "A React library for LDO and Solid",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && NODE_OPTIONS=--max-old-space-size=8192 tsdown",
    "test": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "build:ldo": "ldo build --input src/shapes --output src/ldo",
    "lint:check": "eslint src/** --no-error-on-unmatched-pattern",
    "lint": "npm run lint:check -- --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/o-development/ldo.git"
  },
  "author": "Jackson Morgan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/o-development/ldo/issues"
  },
  "homepage": "https://github.com/o-development/ldo/tree/main/packages/solid-react#readme",
  "devDependencies": {
    "@ldo/rdf-utils": "^1.0.0-alpha.53",
    "@rdfjs/types": "^1.0.1",
    "@testing-library/react": "^14.1.2",
    "@types/react": "^18.3.29",
    "jose": "^5.10.0",
    "start-server-and-test": "^2.0.3",
    "whatwg-fetch": "^3.6.20"
  },
  "dependencies": {
    "@ldo/connected": "^1.0.0-alpha.53",
    "@ldo/connected-solid": "^1.0.0-alpha.53",
    "@ldo/react": "^1.0.0-alpha.53",
    "@uvdsl/solid-oidc-client-browser": "^0.2.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "53d9084eca49d9d8c55fca9892483a07636250f5"
}
